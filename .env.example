# XSS Lab Environment Configuration
# Copy this to .env and customize for your environment

# ============================================
# Server Configuration
# ============================================
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ============================================
# Application Configuration
# ============================================
APP_NAME=XSS Attack Lab
APP_VERSION=1.0.0
APP_DESCRIPTION=Interactive XSS Attack Learning Platform

# ============================================
# Frontend Configuration
# ============================================
# Used by frontend to construct API URLs
REACT_APP_API_BASE_URL=http://localhost
REACT_APP_API_PORT=80
REACT_APP_API_PROTOCOL=http
REACT_APP_ENABLE_HTTPS=false

# For Cloud Deployment Examples:
# REACT_APP_API_BASE_URL=api.xsslab.example.com
# REACT_APP_API_PORT=443
# REACT_APP_PROTOCOL=https
# REACT_APP_ENABLE_HTTPS=true

# ============================================
# Elgg Database Configuration
# ============================================
ELGG_DB_PASSWORD=replace-with-a-local-password
ELGG_DB_ROOT_PASSWORD=replace-with-a-local-root-password
ELGG_PORT=8080

# ============================================
# Redis Cache Configuration (Optional)
# ============================================
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TO_FILE=false
LOG_FILE_PATH=/var/log/xss-lab/app.log

# Options: json, text
# For cloud: Use json for structured logging (ELK, CloudWatch, etc.)

# ============================================
# Security Configuration
# ============================================
CORS_ENABLED=true
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000
HELMET_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# Student Container Configuration
# ============================================
# Used by each backend container to identify itself
STUDENT_ID=student1
STUDENT_NUMBER=1
CONTAINER_NAME=xss-lab-backend-student1

# ============================================
# Cloud Provider Configuration
# ============================================
CLOUD_PROVIDER=local
# Options: local, aws, gcp, azure, digital_ocean

# AWS Configuration
AWS_REGION=us-east-1
AWS_S3_BUCKET=xss-lab-data
AWS_CLOUDWATCH_ENABLED=false

# GCP Configuration
GCP_PROJECT_ID=my-project
GCP_REGION=us-central1

# Azure Configuration
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=xss-lab

# ============================================
# Reverse Proxy Configuration
# ============================================
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
RATE_LIMIT_ZONE_SIZE=10m
RATE_LIMIT_PER_IP=100r/s

# ============================================
# Monitoring & Observability
# ============================================
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
JAEGER_ENABLED=false
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831

# ============================================
# Feature Flags
# ============================================
FEATURE_ELGG_PORTAL=true
FEATURE_XSS_WORKSHOP=true
FEATURE_TASK_GUIDE=true
FEATURE_PROGRESS_SAVE=true
FEATURE_LEADERBOARD=false

# ============================================
# Session & State Management
# ============================================
SESSION_STORAGE=memory
# Options: memory, redis, database
SESSION_EXPIRY=86400

# ============================================
# Deployment Information
# ============================================
DEPLOYMENT_ENV=local
DEPLOYMENT_REGION=local
DEPLOYMENT_VERSION=1.0.0
DEPLOYMENT_TIMESTAMP=

# Examples for different clouds:
# DEPLOYMENT_ENV=aws-production
# DEPLOYMENT_REGION=us-east-1
# DEPLOYMENT_ENV=gcp-staging
# DEPLOYMENT_REGION=us-central1
