{
  "name": "xss-lab-backend",
  "version": "1.0.0",
  "description": "Backend for XSS Attack Lab",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:frontend": "node build-frontend.js",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "terminal": "node terminal-server.js",
    "dev:all": "npm run build:frontend && concurrently \"npm run dev\" \"npm run terminal\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-http-proxy": "latest",
    "helmet": "^7.1.0",
    "node-pty": "^1.1.0",
    "uuid": "^9.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
